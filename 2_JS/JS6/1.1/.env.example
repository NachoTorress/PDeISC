# Copiar este archivo como ".env" y completar con los datos reales
# Puerto donde correra el servidor de Node
PORT=3000

# Secreto usado para firmar la cookie de sesion del panel de admin
# (poner cualquier cadena larga y aleatoria en produccion)
SESSION_SECRET=cambiar-este-secreto-en-produccion

# Datos de conexion a MySQL (local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Score
