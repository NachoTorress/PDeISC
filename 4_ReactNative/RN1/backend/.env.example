PORT=4000
APP_BASE_URL=https://tu-dominio-asignado.ngrok-free.dev
LOG_LEVEL=info
# Carpeta relativa a backend/. Se crea automáticamente y queda fuera de Git.
LOG_DIR=logs
FRONTEND_SCHEME=accesoexpo
# Opcional: origen del frontend web si se publica en otro dominio. Vacío para usar solo Expo Go.
WEB_BASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=acceso_usuarios
JWT_SECRET=replace-with-at-least-32-random-characters
TOKEN_HMAC_SECRET=replace-with-another-32-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Acceso <no-reply@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
