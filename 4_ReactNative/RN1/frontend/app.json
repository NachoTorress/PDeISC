{
  "expo": {
    "name": "Acceso",
    "slug": "acceso-expo",
    "scheme": "accesoexpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "web": { "bundler": "metro", "name": "Acceso" },
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "com.nacho.acceso", "supportsTablet": true },
    "android": { "package": "com.nacho.acceso", "adaptiveIcon": { "backgroundColor": "#F4F2EC" } },
    "plugins": ["expo-secure-store"]
  }
}
