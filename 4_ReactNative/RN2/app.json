{
  "expo": {
    "name": "Pulso",
    "slug": "pulso-native",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F5EF",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulsolab.mobile"
    },
    "android": {
      "package": "com.pulsolab.mobile",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D9F279"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Pulso · Laboratorio del dispositivo",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Pulso necesita la cámara para tomar fotos y leer códigos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pulso usa tu ubicación únicamente mientras probás el GPS.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pulso usa Face ID para demostrar la autenticación biométrica del dispositivo."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Pulso necesita leer el movimiento para mostrar el acelerómetro y el giroscopio."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "259578be-2189-4b94-b103-66c8a467dca0"
      }
    },
    "owner": "nachot"
  }
}
