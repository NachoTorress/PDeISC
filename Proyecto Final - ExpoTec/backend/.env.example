# Copiar a .env. Las credenciales se configuran SOLO en el backend.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# En TiDB, copiar host y usuario completos desde Connect. Crear la base expotec antes de migrar.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=expotec
DB_SSL=true
# Opcional: certificado CA en formato PEM. En Vercel admite saltos de línea escapados con \n.
DB_SSL_CA=
DB_POOL_LIMIT=5

# SOLO para test:database: base VACÍA y exclusiva para pruebas, nunca la base real.
TEST_DB_NAME=

# Accesos sociales web opcionales. Sin pares ID/SECRET no se muestran botones.
# Configurar estos valores SOLO en backend/Vercel, nunca con EXPO_PUBLIC_.
SOCIAL_WEB_ORIGIN=https://expotec-web-gn19.vercel.app
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_DISCORD_CLIENT_ID=
SOCIAL_DISCORD_CLIENT_SECRET=
SOCIAL_GITHUB_CLIENT_ID=
SOCIAL_GITHUB_CLIENT_SECRET=

# Almacenamiento privado de fotos. Vercel lo configura al conectar expotec-fotos al backend.
# Nunca usar EXPO_PUBLIC_ ni copiar este token al frontend.
BLOB_READ_WRITE_TOKEN=

# Recuperación por Gmail: contraseña DE APLICACIÓN, nunca la contraseña principal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_WEB_ORIGIN=https://expotec-web-gn19.vercel.app
