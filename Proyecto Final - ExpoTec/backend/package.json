{
  "name": "expotec-api",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "db:setup": "node --env-file-if-exists=.env --env-file=.env.setup scripts/setup-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup scripts/migrate.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.mjs",
    "db:prune": "node --env-file-if-exists=.env scripts/prune.mjs",
    "admin:grant": "node --env-file-if-exists=.env scripts/grant-admin.mjs",
    "test:database": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/database.integration.mjs",
    "test:spaces": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/spaces.integration.mjs",
    "test:users": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/admin-users.integration.mjs",
    "test:gallery": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/gallery.integration.mjs",
    "test:uploads": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --env-file-if-exists=.env.uploads --test test/uploads.integration.mjs",
    "test:recovery": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/recovery.integration.mjs",
    "test:social": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/social.integration.mjs",
    "test:projects": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/projects.integration.mjs",
    "test:inventory": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/inventory.integration.mjs",
    "test:loans": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/loans.integration.mjs",
    "test:presentation": "node --env-file-if-exists=.env --env-file-if-exists=.env.setup --test test/presentation.integration.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "3.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mysql2": "3.24.6",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5"
  }
}
