<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; base-uri 'none'; form-action 'none'">
<title>ExpoTec · Mapa del código</title>
<style>
*{box-sizing:border-box} :root{font:15px/1.55 system-ui,-apple-system,Segoe UI,sans-serif;color:#172a3a;background:#f6f8fa;--line:#d8e1e8;--blue:#225c91}body{margin:0}button,input,select{font:inherit}button,a,input,select{touch-action:manipulation}button{cursor:pointer;border:1px solid #b7c8d5;border-radius:5px;background:#fff;color:#1b405e;padding:7px 12px}button:hover{background:#eaf2f8}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:3px solid #b96a15;outline-offset:3px}a{color:var(--blue);text-underline-offset:3px}header{background:#142c41;color:#fff;padding:26px max(24px,calc((100vw - 1600px)/2));border-bottom:4px solid #4e91c1}header .eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#a9c7de}h1{font-size:30px;line-height:1.2;margin:6px 0 9px;font-weight:650}header p{margin:0;max-width:920px;color:#d3e2ec}main{max-width:1650px;padding:22px 24px 40px;margin:auto}.intro{display:flex;justify-content:space-between;gap:24px;align-items:center;margin-bottom:18px}.intro p{margin:0;max-width:850px}.intro a{white-space:nowrap}.modes{display:flex;gap:0;margin-bottom:16px}.modes button{border-radius:0;padding:8px 20px}.modes button:first-child{border-radius:5px 0 0 5px}.modes button:last-child{border-radius:0 5px 5px 0}.modes button[aria-pressed=true]{color:#fff;background:#225c91;border-color:#225c91}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 310px;background:white;border:1px solid var(--line);border-radius:6px;overflow:hidden}.canvas-area{min-width:0}.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:12px 15px;border-bottom:1px solid var(--line);background:#fafcfd}.toolbar label{font-size:13px;font-weight:600}.toolbar select{max-width:100%;padding:7px;border:1px solid #b7c8d5;border-radius:4px;background:#fff;color:#172a3a}.zoom{display:flex;align-items:center;gap:5px;margin-left:auto}.zoom button{padding:5px 9px}.zoom output{min-width:42px;text-align:center;font-size:12px}.view-note{margin:0;padding:12px 17px;font-size:13px;border-bottom:1px solid #e7edf2;color:#41566a;min-height:65px}.viewport{height:65vh;min-height:440px;max-height:850px;overflow:auto;background-color:#fff;background-image:radial-gradient(#cfdce5 .65px,transparent .65px);background-size:14px 14px;overscroll-behavior:contain}.drawing{min-width:100%;min-height:100%;padding:16px;display:flex;align-items:flex-start;justify-content:flex-start}.drawing svg{flex-shrink:0;max-width:none;height:auto}.drawing g.node{cursor:pointer}.drawing g.node:focus{outline:none}.drawing g.node:hover>path,.drawing g.node:focus>path,.drawing g.node.chosen>path{stroke:#d27516;stroke-width:2.8}.drawing g.node.chosen>polygon{stroke:#d27516;stroke-width:2.8}.downloads{padding:10px 16px;border-top:1px solid var(--line);display:flex;gap:20px;flex-wrap:wrap;font-size:13px}.inspector{border-left:1px solid var(--line);padding:20px 20px 24px;background:#f9fbfd;overflow-wrap:anywhere}.inspector h2{font-size:21px;margin:7px 0 14px;line-height:1.25}.inspector p{margin:0 0 13px}.kicker{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#5b7082}.badge{display:inline-block;border:1px solid #bed0df;background:#edf5fc;border-radius:3px;padding:2px 7px;font-size:11px;margin-bottom:10px}.badge[data-status=legacy]{background:#fff1d9;border-color:#cfad6b}.badge[data-status=generated],.badge[data-status=local]{background:#eceff3;border-color:#bfc5ce}.badge[data-status=output]{background:#e6f5e9;border-color:#98c0a4}.badge[data-status=external]{background:#f1eaff;border-color:#bea9db}.badge[data-status=private]{background:#ffeded;border-color:#d4a4a4}.path{font:12px/1.6 ui-monospace,Consolas,monospace;background:#edf1f5;border:1px solid #dbe2e8;padding:10px;white-space:pre-wrap;margin:12px 0}.small{font-size:12px;color:#586e80}.inspector h3{font-size:13px;margin:24px 0 7px}.children{padding:0;list-style:none}.children li{margin:5px 0}.children button{padding:0;border:0;background:transparent;text-align:left;color:var(--blue);text-decoration:underline;text-underline-offset:3px;font-size:12px}.inspector .count{font-size:12px;color:#586e80;margin:8px 0}.legend{display:flex;flex-wrap:wrap;gap:14px;padding:12px 0;color:#496071;font-size:12px}.legend span:before{content:'';display:inline-block;width:9px;height:9px;background:var(--swatch);border:1px solid #8496a6;margin-right:5px}.explorer{padding:15px;min-height:560px;max-height:79vh;overflow:auto}.searchbox{display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap}.searchbox input{flex:1;min-width:130px;border:1px solid #aebfce;border-radius:4px;padding:9px 11px}.searchbox label{font-size:13px;font-weight:600}.results-count{font-size:12px;color:#5b7082;margin:8px 0}#tree ul{list-style:none;margin:0 0 0 13px;padding:0 0 0 14px;border-left:1px solid #d8e1e8}#tree>ul{border:0;margin:0;padding:0}#tree li{margin:1px 0}.tree-row{display:flex;gap:4px;align-items:center;min-height:29px}.tree-row button{padding:2px 4px;border:0;background:transparent;border-radius:2px;text-align:left;font:13px/1.5 ui-monospace,Consolas,monospace;color:#234460}.tree-row .toggle{width:23px;flex-shrink:0;font:16px system-ui;text-align:center}.tree-row .tree-select{flex:1;overflow-wrap:anywhere}.tree-row button[aria-current=true]{background:#dcecf8;font-weight:700}.tree-row .tree-select:hover{background:#eef4fa}.file-row{display:block;border-bottom:1px solid #e5ebef;padding:9px 5px;width:100%;border-radius:0;text-align:left;background:#fff}.file-row strong{display:block;font:13px ui-monospace,Consolas,monospace;overflow-wrap:anywhere}.file-row span{font-size:12px;color:#546a7b}.file-row[aria-current=true]{background:#e8f2fa}.guide{border-top:1px solid var(--line);margin-top:24px;padding-top:20px}.guide h2{font-size:20px;margin:0 0 10px}.guide table{border-collapse:collapse;width:100%;font-size:13px;background:#fff}.guide td,.guide th{border-bottom:1px solid var(--line);padding:10px 12px;text-align:left;vertical-align:top}.guide th{background:#edf2f6}.guide button{font:12px ui-monospace,Consolas,monospace;padding:0;border:0;color:var(--blue);text-decoration:underline;text-align:left;overflow-wrap:anywhere}.guide code{font-size:12px}footer{margin-top:22px;color:#5b7082;font-size:12px}[hidden]{display:none!important}@media(max-width:1000px){.workspace{grid-template-columns:minmax(0,1fr) 265px}.inspector{padding:16px}.intro{align-items:flex-start}}@media(max-width:720px){header{padding:22px 16px}h1{font-size:25px}main{padding:16px 12px}.intro{display:block}.intro a{display:inline-block;margin-top:10px}.workspace{display:block}.inspector{border-left:0;border-top:1px solid var(--line)}.viewport{height:58vh;min-height:330px}.zoom{margin-left:0}.toolbar{gap:8px}.toolbar select{width:100%;font-size:13px}.explorer{max-height:60vh;min-height:300px}.guide td,.guide th{padding:8px 5px}.guide td:first-child{width:35%}}
</style>
<header><div class="eyebrow">ExpoTec / guía del repositorio</div><h1>Dónde está cada parte del programa</h1><p>Mapa de carpetas, archivos importantes y salidas de compilación. Seleccioná un bloque para conocer su función o buscá un archivo en el explorador.</p></header>
<main>
<noscript>Activá JavaScript para usar el explorador. También podés abrir el <a href="mapa-general.svg">diagrama general en SVG</a> o la <a href="../MAPA_DEL_CODIGO.md">guía escrita</a>.</noscript>
<div class="intro"><p><strong>La web actual y la APK salen de <code>frontend/native</code>.</strong> <code>frontend/web</code> conserva el prototipo anterior. El backend se publica por separado y guarda los datos en TiDB.</p><a href="modelos-datos.html">Abrir DFD y DER →</a></div>
<div class="modes" aria-label="Forma de explorar"><button id="diagram-mode" aria-pressed="true">Diagramas</button><button id="files-mode" aria-pressed="false">Carpetas y archivos</button></div>
<div class="workspace">
<section class="canvas-area" aria-label="Mapa y explorador">
<div id="diagram-panel">
<div class="toolbar"><label for="view">Vista</label><select id="view"></select><div class="zoom" aria-label="Ampliación"><button id="minus" aria-label="Reducir">−</button><output id="scale" aria-live="polite">100%</output><button id="plus" aria-label="Ampliar">+</button><button id="fit">Ajustar ancho</button><button id="all">Ver todo</button><button id="actual">100%</button></div></div>
<p id="view-note" class="view-note"></p><div class="viewport" id="viewport"><div class="drawing" id="drawing"></div></div>
<div class="downloads"><a id="svg-link" download>Descargar esta vista (SVG)</a><a href="Mapa-del-codigo-ExpoTec.drawio" download>Editable draw.io · 5 páginas</a><a href="../MAPA_DEL_CODIGO.md">Guía escrita</a></div>
</div>
<div id="files-panel" class="explorer" hidden><div class="searchbox"><label for="search">Buscar</label><input type="search" id="search" placeholder="Carpeta, archivo o función…" autocomplete="off"><button id="clear">Limpiar</button><button id="collapse">Plegar árbol</button></div><p id="results-count" class="results-count" aria-live="polite"></p><div id="tree"></div></div>
</section>
<aside class="inspector" id="inspector" aria-label="Detalle de la ubicación"></aside>
</div>
<div class="legend" aria-label="Leyenda"><span style="--swatch:#eef6ff">Fuente / configuración</span><span style="--swatch:#fff3dd">Anterior</span><span style="--swatch:#eaf7ee">Entregable / evidencia</span><span style="--swatch:#f0f1f4">Local / generado</span><span style="--swatch:#f1ecff">Servicio remoto</span><span style="--swatch:#ffeded">Privado</span></div>
<section class="guide"><h2>Quiero cambiar algo: ¿por dónde empiezo?</h2><table><thead><tr><th>Qué querés cambiar</th><th>Ubicación principal</th><th>También revisar</th></tr></thead><tbody id="tasks"></tbody></table></section>
<footer>Inventario basado en rutas del repositorio y ubicaciones locales documentadas. Las descripciones marcadas como generales se heredan de la carpeta o del tipo de archivo. No se incluyen contenidos privados. El visor funciona sin conexión; los enlaces a fuentes requieren conservar la estructura del proyecto.</footer>
</main>
<script>
'use strict';
const model = /*__CODE_MAP__*/;
const $=id=>document.getElementById(id), catalog=new Map(model.catalog.map(e=>[e.path,e])), external=new Map(model.external.map(e=>[e.path,e]));
const labels={source:'Fuente / configuración',legacy:'Anterior / histórico',output:'Entregable / evidencia',generated:'Generado / ignorado',local:'Solo local',private:'Privado',external:'Servicio remoto'};
const html=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
let current=model.views[0], selected='.', scale=1, fitMode='width', mode='diagram';
const expanded=new Set(['.','frontend','backend','docs']);
const normal=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
for(const v of model.views){const o=document.createElement('option');o.value=v.id;o.textContent=v.title;$('view').append(o);}
function setMode(next){mode=next;$('diagram-mode').setAttribute('aria-pressed',next==='diagram');$('files-mode').setAttribute('aria-pressed',next==='files');$('diagram-panel').hidden=next!=='diagram';$('files-panel').hidden=next!=='files';if(next==='files')renderTree();else requestAnimationFrame(fit);}
function showEntry(p){
  const e=catalog.get(p)??external.get(p);if(!e)return;selected=p;
  const base=p==='.'?'ExpoTec/':p.startsWith('@')?e.label:p.split('/').pop()+(e.type==='directory'?'/':'');
  const siblings=e.children??[];
  $('inspector').innerHTML=`<div class="kicker">${e.status==='external'?'Fuera del repositorio':e.type==='directory'?'Carpeta':e.status==='private'?'Ubicación privada':'Archivo'}</div><h2>${html(base)}</h2><span class="badge" data-status="${html(e.status)}">${labels[e.status]}</span><p>${html(e.summary)}</p>${e.note?`<p class="small">${html(e.note)}</p>`:''}${!p.startsWith('@')?`<div class="path">${html(p==='.'?'Proyecto Final - ExpoTec/':p)}</div>`:''}${e.fileCount!==undefined?`<div class="count">${e.fileCount} archivos en el inventario de esta carpeta.</div>`:''}${e.descriptionBasis&&e.descriptionBasis!=='documented'?'<p class="small">Descripción general según '+(e.descriptionBasis==='folder'?'la función de su carpeta.':'el nombre o tipo de archivo.')+'</p>':''}${e.type==='file'&&e.status!=='private'&&e.status!=='generated'&&e.status!=='local'?`<p><a href="../../${p.split('/').map(encodeURIComponent).join('/')}">Abrir archivo fuente ↗</a></p>`:''}${siblings.length?`<h3>Contenido inmediato (${siblings.length})</h3><ul class="children">${siblings.map(c=>`<li><button data-select="${html(c)}">${html(c.split('/').pop())}${catalog.get(c).type==='directory'?'/':''}</button></li>`).join('')}</ul>`:''}${e.type==='directory'?'<button id="reveal">Ver en el explorador</button>':''}`;
  $('inspector').querySelectorAll('[data-select]').forEach(b=>b.onclick=()=>{showEntry(b.dataset.select);if(mode==='files')renderTree();});
  const reveal=$('reveal');if(reveal)reveal.onclick=()=>{for(let a=p;a!=='.';a=a.includes('/')?a.slice(0,a.lastIndexOf('/')):'.')expanded.add(a);expanded.add('.');expanded.add(p);$('search').value='';setMode('files');requestAnimationFrame(()=>$('tree').querySelector('[aria-current=true]')?.scrollIntoView({block:'nearest'}));};
  $('drawing').querySelectorAll('[data-path]').forEach(n=>n.classList.toggle('chosen',n.dataset.path===p));
  if(mode==='files')$('tree').querySelectorAll('[data-select]').forEach(b=>b.setAttribute('aria-current',b.dataset.select===p));
}
function setScale(n,how='manual'){scale=Math.min(2.5,Math.max(.12,n));fitMode=how;const svg=$('drawing').querySelector('svg');if(!svg)return;svg.style.width=(svg.viewBox.baseVal.width*scale)+'px';$('scale').textContent=Math.round(scale*100)+'%';}
function fit(){if(mode!=='diagram')return;const svg=$('drawing').querySelector('svg');if(!svg)return;const box=svg.viewBox.baseVal;if(fitMode==='width')setScale(($('viewport').clientWidth-34)/box.width,'width');else if(fitMode==='all')setScale(Math.min(($('viewport').clientWidth-34)/box.width,($('viewport').clientHeight-34)/box.height),'all');}
function showView(){current=model.views.find(v=>v.id===$('view').value);$('view-note').textContent=current.note;$('drawing').innerHTML=current.svg;$('svg-link').href=current.id+'.svg';fitMode='width';fit();$('viewport').scrollTop=0;$('viewport').scrollLeft=0;$('drawing').querySelectorAll('[data-path]').forEach(n=>{n.onclick=()=>showEntry(n.dataset.path);n.onkeydown=ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();showEntry(n.dataset.path);}};});showEntry(current.nodes[0].path);}
function treeBranch(p){const e=catalog.get(p),li=document.createElement('li'),row=document.createElement('div');row.className='tree-row';li.append(row);if(e.type==='directory'){const toggle=document.createElement('button');toggle.className='toggle';toggle.textContent=expanded.has(p)?'▾':'▸';toggle.setAttribute('aria-label',(expanded.has(p)?'Plegar ':'Expandir ')+p);toggle.setAttribute('aria-expanded',expanded.has(p));toggle.onclick=()=>{expanded.has(p)?expanded.delete(p):expanded.add(p);renderTree();};row.append(toggle);}else{const space=document.createElement('span');space.style.width='23px';space.style.flexShrink=0;row.append(space);}const b=document.createElement('button');b.className='tree-select';b.dataset.select=p;b.setAttribute('aria-current',p===selected);b.textContent=(p==='.'?'ExpoTec':p.split('/').pop())+(e.type==='directory'?'/':'');b.onclick=()=>showEntry(p);row.append(b);if(e.type==='directory'&&expanded.has(p)){const ul=document.createElement('ul');for(const c of e.children)ul.append(treeBranch(c));li.append(ul);}return li;}
function renderTree(){
  const query=normal($('search').value.trim());$('tree').replaceChildren();
  if(!query){const ul=document.createElement('ul');ul.append(treeBranch('.'));$('tree').append(ul);$('results-count').textContent=`${model.catalog.filter(e=>e.type==='file'&&e.status!=='private').length} archivos catalogados; incluye entregables y ubicaciones locales documentadas.`;return;}
  const matches=model.catalog.filter(e=>normal(e.path+' '+e.summary+' '+e.note).includes(query));
  $('results-count').textContent=matches.length?`${matches.length} coincidencias.`:'No hay coincidencias. Probá con el nombre de una carpeta o función.';
  for(const e of matches){const b=document.createElement('button');b.className='file-row';b.dataset.select=e.path;b.setAttribute('aria-current',e.path===selected);b.innerHTML=`<strong>${html(e.path)}${e.type==='directory'?'/':''}</strong><span>${html(e.summary)}</span>`;b.onclick=()=>showEntry(e.path);$('tree').append(b);}
}
const tasks=[
 ['Una pantalla o formulario','frontend/native/src/pages','Componentes de la sección y validación en src/lib.'],
 ['Menú y navegación','frontend/native/src/components/navigation','src/app.tsx; permisos reales también en el backend.'],
 ['Colores, tamaños o botones','frontend/native/src/theme','src/components/base; DESIGN.md.'],
 ['Acceso y permisos','frontend/native/src/contexts/AuthContext.tsx','Clientes auth, backend/src/middleware y services.'],
 ['Proyectos y propuestas','frontend/native/src/lib/sharedProjects.ts','SharedProposalPage, hooks y backend: routes/validators/repositories de projects.'],
 ['Fotos y moderación','frontend/native/src/lib/gallery.ts','SharedGalleryPage, GalleryReviewForm y backend de gallery/uploads.'],
 ['Reglas y validaciones del servidor','backend/src/validators','Repositorios del dominio y middleware de permisos.'],
 ['Tablas y relaciones','backend/sql','Agregar migración; revisar repositorios y DER.'],
 ['Versión o compilación de APK','frontend/native/app.json','package.json, eas.json, .easignore; APK resultante en artifacts/android.'],
 ['Publicación de la web','frontend/native/vercel.json','export:web genera dist; API tiene su propio despliegue.'],
 ['Datos de la demostración','frontend/native/src/contexts/DemoContext.tsx','src/lib/model.ts, seed.ts y persistence.ts.'],
 ['Manuales o diagramas','docs','Fuentes en docs; generadores en docs/scripts; PDF en output/pdf.'],
];
for(const [title,p,note]of tasks){const tr=document.createElement('tr');tr.innerHTML=`<td>${html(title)}</td><td><button data-select="${html(p)}">${html(p)}</button></td><td>${html(note)}</td>`;tr.querySelector('button').onclick=()=>{showEntry(p);$('inspector').scrollIntoView({block:'nearest'});};$('tasks').append(tr);}
$('view').onchange=showView;$('diagram-mode').onclick=()=>setMode('diagram');$('files-mode').onclick=()=>setMode('files');$('plus').onclick=()=>setScale(scale*1.25);$('minus').onclick=()=>setScale(scale/1.25);$('actual').onclick=()=>setScale(1);$('fit').onclick=()=>{fitMode='width';fit();};$('all').onclick=()=>{fitMode='all';fit();};$('search').oninput=renderTree;$('clear').onclick=()=>{$('search').value='';renderTree();$('search').focus();};$('collapse').onclick=()=>{expanded.clear();expanded.add('.');$('search').value='';renderTree();};new ResizeObserver(fit).observe($('viewport'));showView();
</script>
</html>
