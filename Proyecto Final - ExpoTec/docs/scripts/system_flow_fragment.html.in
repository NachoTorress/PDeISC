<div id="expotec-system-flow">
  <div class="viz-controls">
    <label class="form-label" for="expotec-flow-choice">Recorrido de ExpoTec
      <select id="expotec-flow-choice" class="form-select" aria-label="Recorrido de ExpoTec"></select>
    </label>
  </div>
  <div class="expotec-flow-drawing"></div>
  <div class="text-small" aria-live="polite" data-flow-detail></div>
</div>
<style>
  #expotec-system-flow .expotec-flow-drawing { width: 100%; min-width: 0; }
  #expotec-system-flow .expotec-flow-svg { display: block; width: 100%; }
  #expotec-system-flow .expotec-flow-svg text { fill: var(--foreground); font-family: inherit; }
  #expotec-system-flow .expotec-flow-svg .flow-secondary { fill: var(--muted-foreground); }
  #expotec-system-flow .expotec-flow-svg .flow-edge-label { paint-order: stroke; stroke: var(--background); stroke-width: 5px; stroke-linejoin: round; }
</style>
<script>
(() => {
  const root = document.getElementById('expotec-system-flow');
  const flows = __FLOW_DATA__;
  const select = root.querySelector('select');
  const drawing = root.querySelector('.expotec-flow-drawing');
  const detail = root.querySelector('[data-flow-detail]');
  const ns = 'http://www.w3.org/2000/svg';
  const hasFlow = id => flows.some(flow => flow.id === id);
  const stored = window.openai?.widgetState?.modelContent?.flow;
  let currentId = hasFlow(stored) ? stored : flows[0].id;
  for (const flow of flows) {
    const option = document.createElement('option');
    option.value = flow.id;
    option.textContent = flow.title;
    select.append(option);
  }
  function el(name, attrs, parent, text) {
    const node = document.createElementNS(ns, name);
    for (const [key, value] of Object.entries(attrs || {})) node.setAttribute(key, value);
    if (text !== undefined) node.textContent = text;
    if (parent) parent.append(node);
    return node;
  }
  function wrap(text, limit) {
    const lines = [''];
    for (const word of text.split(' ')) {
      const last = lines.length - 1;
      if (lines[last] && lines[last].length + word.length + 1 > limit) lines.push(word);
      else lines[last] += (lines[last] ? ' ' : '') + word;
    }
    return lines;
  }
  function draw() {
    const flow = flows.find(item => item.id === currentId);
    select.value = currentId;
    const width = Math.max(280, Math.round(drawing.clientWidth));
    const columns = width < 540 ? 1 : width < 690 ? 2 : 3;
    const margin = 36;
    const gap = 18;
    const maxNodeWidth = 260;
    const height = 94;
    const rowGap = 68;
    const boxes = new Map();
    const ranks = [...new Set(flow.nodes.map(node => node.rank))];
    let row = 0;
    for (const rank of ranks) {
      const nodes = flow.nodes.filter(node => node.rank === rank);
      for (let offset = 0; offset < nodes.length; offset += columns) {
        const batch = nodes.slice(offset, offset + columns);
        const nodeWidth = Math.min(maxNodeWidth, (width - margin * 2 - gap * (batch.length - 1)) / batch.length);
        const left = (width - nodeWidth * batch.length - gap * (batch.length - 1)) / 2;
        batch.forEach((node, i) => boxes.set(node.id, { x: left + i * (nodeWidth + gap), y: 16 + row * (height + rowGap), w: nodeWidth, h: height }));
        row++;
      }
    }
    const projectLayout = flow.id === 'proyectos' && columns > 1;
    if (projectLayout) {
      for (const id of ['changes','cancelled']) boxes.get(id).x = margin;
      for (const id of ['approved','publico','reabrir']) boxes.get(id).x = width - margin - boxes.get(id).w;
    }
    const fullHeight = row * (height + rowGap) + 16;
    const svg = el('svg', {class:'expotec-flow-svg', viewBox:`0 0 ${width} ${fullHeight}`, height:fullHeight, role:'img', 'aria-labelledby':'expotec-flow-svg-title expotec-flow-svg-desc'});
    el('title', {id:'expotec-flow-svg-title'}, svg, flow.title);
    el('desc', {id:'expotec-flow-svg-desc'}, svg, flow.takeaway + ' ' + flow.edges.map(edge => `${flow.nodes.find(n => n.id === edge.source).label}: ${edge.label}; ${flow.nodes.find(n => n.id === edge.target).label}.`).join(' '));
    const defs = el('defs', {}, svg);
    const marker = el('marker', {id:'expotec-flow-arrow', markerWidth:7, markerHeight:7, refX:6, refY:3.5, orient:'auto'}, defs);
    el('path', {d:'M0 0 L7 3.5 L0 7Z', fill:'var(--muted-foreground)'}, marker);
    const labels = [];
    for (const [index, edge] of flow.edges.entries()) {
      const a = boxes.get(edge.source), b = boxes.get(edge.target);
      let points;
      let lx, ly;
      if (projectLayout && edge.target === 'cancelled') {
        if (edge.source === 'approved') points = [[a.x+a.w/2,a.y+a.h],[a.x+a.w/2,a.y+a.h+20],[width/2,a.y+a.h+20],[width/2,b.y-22],[b.x+b.w/2,b.y-22],[b.x+b.w/2,b.y]];
        else points = [[a.x+a.w/2,a.y+a.h],[a.x+a.w/2,b.y-22],[b.x+b.w/2,b.y-22],[b.x+b.w/2,b.y]];
        lx = b.x+b.w/2; ly = b.y-30;
      } else if (b.y > a.y && b.y - a.y <= height + rowGap) {
        const mid = (a.y + a.h + b.y) / 2;
        points = [[a.x+a.w/2,a.y+a.h],[a.x+a.w/2,mid],[b.x+b.w/2,mid],[b.x+b.w/2,b.y]];
        lx = (a.x+a.w/2+b.x+b.w/2)/2; ly = mid - 8;
      } else if (b.y > a.y) {
        const lane = width - 12 - index % 3 * 7;
        points = [[a.x+a.w/2,a.y+a.h],[a.x+a.w/2,a.y+a.h+20],[lane,a.y+a.h+20],[lane,b.y-22],[b.x+b.w/2,b.y-22],[b.x+b.w/2,b.y]];
        lx = (a.x+a.w+lane)/2; ly = a.y+a.h/2-8;
      } else {
        const lane = projectLayout && edge.source === 'reabrir' ? width-12 : 10 + index % 3 * 7;
        points = [[a.x+a.w/2,a.y+a.h],[a.x+a.w/2,a.y+a.h+20],[lane,a.y+a.h+20],[lane,b.y-12],[b.x+b.w/2,b.y-12],[b.x+b.w/2,b.y]];
        lx = (a.x+a.w/2+lane)/2; ly = a.y+a.h+39;
      }
      el('polyline', {points:points.map(p => p.join(',')).join(' '), fill:'none', stroke:'var(--muted-foreground)', 'stroke-width':1.2, 'marker-end':'url(#expotec-flow-arrow)'}, svg);
      if (!(b.y - a.y > height + rowGap)) labels.push({text:edge.label,x:lx,y:ly});
    }
    for (const node of flow.nodes) {
      const b = boxes.get(node.id);
      const group = el('g', {'aria-label':`${node.label}. ${node.detail}`, 'data-tooltip':node.source}, svg);
      el('rect', {x:b.x,y:b.y,width:b.w,height:b.h,rx:6,fill:'var(--muted)',stroke:'var(--border)'}, group);
      const mainLines = wrap(node.label, Math.max(16, Math.floor((b.w-22)/7.4)));
      mainLines.forEach((text,i) => el('text', {x:b.x+b.w/2,y:b.y+25+i*18,'text-anchor':'middle','font-size':14,'font-weight':500}, group,text));
      const secondary = wrap(node.detail, Math.max(22, Math.floor((b.w-20)/6.1)));
      secondary.forEach((text,i) => el('text', {x:b.x+b.w/2,y:b.y+51+(mainLines.length-1)*18+i*15,'text-anchor':'middle','font-size':12,class:'flow-secondary'}, group,text));
    }
    for (const label of labels) {
      const x = Math.max(92, Math.min(width-92,label.x));
      wrap(label.text, 23).forEach((text,i) => el('text', {x,y:label.y+i*14,'text-anchor':'middle','font-size':12,class:'flow-edge-label'},svg,text));
    }
    drawing.replaceChildren(svg);
    detail.textContent = flow.takeaway;
  }
  select.addEventListener('change', () => {
    if (!hasFlow(select.value)) return;
    currentId = select.value;
    draw();
    if (window.openai?.setWidgetState) window.openai.setWidgetState({modelContent:{flow:currentId},privateContent:{}}).catch(() => {});
  });
  window.addEventListener('openai:set_globals', event => {
    const next = event.detail?.globals?.widgetState?.modelContent?.flow;
    if (hasFlow(next) && next !== currentId) {currentId=next;draw();}
  });
  new ResizeObserver(draw).observe(drawing);
  draw();
})();
</script>
