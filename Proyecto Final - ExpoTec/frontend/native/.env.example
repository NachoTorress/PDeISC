# Solo URL pública. Nunca incluir secretos ni variables de base de datos.
# Expo Web en desarrollo: usar el mismo hostname en frontend y API.
EXPO_PUBLIC_API_URL=http://localhost:3001
# En Vercel, dejar sin definir: /api se reenvía al backend desde el mismo origen.
# En Android sin variable se usa la API pública; emulador local: http://10.0.2.2:3001.
