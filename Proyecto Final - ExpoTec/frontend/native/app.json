{
  "expo": {
    "name": "ExpoTec",
    "slug": "expotec-organizacion",
    "scheme": "expotec",
    "version": "0.2.0",
    "icon": "./assets/brand/expotec-icon-v1.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "ar.edu.expotec.organizacion",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/expotec-icon-v1.png",
        "backgroundColor": "#153B2A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "ExpoTec"
    },
    "plugins": [
      ["expo-navigation-bar", { "hidden": true, "enforceContrast": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegí una imagen referencial para tu proyecto de ExpoTec.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "6f64b206-e059-4037-ab1a-4fa0c2459cf7"
      }
    },
    "owner": "nachot"
  }
}
