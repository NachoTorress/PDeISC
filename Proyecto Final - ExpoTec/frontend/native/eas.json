{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_API_URL": "https://expotec-api-gn19.vercel.app"
      },
      "android": { "buildType": "apk" }
    },
    "production": { "android": { "buildType": "app-bundle" } }
  }
}
