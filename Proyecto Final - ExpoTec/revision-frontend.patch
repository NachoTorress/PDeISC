+/**
+ * Fila de cifras destacadas (número grande y etiqueta debajo). Se usa en las
+ * tarjetas de inventario y de préstamos para leer cantidades de un vistazo.
+ */
+import { Text, View } from "react-native";
+import { useTheme } from "../../contexts/ThemeContext";
+
+/** Una cifra: etiqueta visible, valor y, opcionalmente, su tono. */
+export type Stat = {
+  label: string;
+  value: number;
+  /** "success" resalta una cantidad disponible; "warning", una pendiente. */
+  tone?: "neutral" | "success" | "warning";
+};
+
+export function StatRow({ stats }: { stats: Stat[] }) {
+  const { colors } = useTheme();
+  const ink = (tone: Stat["tone"]) =>
+    tone === "success"
+      ? colors.success
+      : tone === "warning"
+        ? colors.onWarning
+        : colors.text;
+  return (
+    <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 8 }}>
+      {stats.map((stat) => (
+        <View key={stat.label} style={{ flex: 1, minWidth: 64, gap: 2 }}>
+          <Text
+            style={{
+              color: ink(stat.tone),
+              fontSize: 20,
+              lineHeight: 25,
+              fontWeight: "600",
+            }}
+          >
+            {stat.value}
+          </Text>
+          <Text style={{ color: colors.muted, fontSize: 12, lineHeight: 17 }}>
+            {stat.label}
+          </Text>
+        </View>
+      ))}
+    </View>
+  );
+}
